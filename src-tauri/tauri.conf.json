{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gram-Gen",
  "version": "0.1.0",
  "identifier": "fr.gramgen.app",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://127.0.0.1:5200",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Gram-Gen",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/gramgen-server"
    ]
  }
}