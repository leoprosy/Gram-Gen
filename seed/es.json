{"concepts": [
  {"code": "es.ser-estar", "langue": "es", "titre": "Ser / estar", "categorie": "Traduction de structures", "fiche": "**Ser** : identité, nature, origine, matière, heure, lieu d'un événement.\n**Estar** : état passager, résultat d'un changement, localisation.\nChangent de sens : `ser listo` (intelligent) / `estar listo` (prêt).", "voisins": ["es.devenir"]},
  {"code": "es.por-para", "langue": "es", "titre": "Por / para", "categorie": "Prépositions", "fiche": "**Por** : cause, échange, moyen, durée, passage, agent du passif.\n**Para** : but, destinataire, destination, échéance, point de vue.\n`estar por` + inf. : rester à faire ; `estar para` + inf. : être sur le point de.", "voisins": ["es.depuis"]},
  {"code": "es.indefinido-imparfait", "langue": "es", "titre": "Prétérit indéfini / imparfait", "categorie": "Temps et modes", "fiche": "Action achevée, datée, ponctuelle → `indefinido` (ayer, en 1975, durante dos años).\nHabitude, description, action de fond → `imperfecto`.\nDurée bornée (durante, tres años) → indefinido, même longue.", "voisins": ["es.subjonctif-present"]},
  {"code": "es.subjonctif-present", "langue": "es", "titre": "Subjonctif et concordance des temps", "categorie": "Temps et modes", "fiche": "Ordre, souhait, doute, sentiment + que → subjonctif.\nPrincipale au présent ou futur → `subj. présent` ; au passé ou conditionnel → `subj. imparfait`.\nCreer que affirmatif → indicatif ; no creer que → subjonctif.", "voisins": ["es.subjonctif-cuando"]},
  {"code": "es.subjonctif-cuando", "langue": "es", "titre": "Subjonctif après cuando, para que, aunque", "categorie": "Temps et modes", "fiche": "cuando, en cuanto, hasta que + idée future → subjonctif présent (jamais le futur).\npara que, sin que, antes de que → toujours subjonctif.\naunque + indicatif : bien que (fait) ; aunque + subjonctif : même si (hypothèse).", "voisins": ["es.subjonctif-present"]},
  {"code": "es.imperatif", "langue": "es", "titre": "Impératif et enclise des pronoms", "categorie": "Temps et modes", "fiche": "Affirmatif : tú = 3e pers. du présent, vosotros = -ad / -ed / -id ; usted = subjonctif.\nNégatif : `no + subjonctif présent` à toutes les personnes.\nEnclise à l'affirmatif (avec accent écrit) : `dímelo` ; pronoms devant au négatif : `no me lo digas`.", "voisins": ["es.irreguliers"]},
  {"code": "es.on", "langue": "es", "titre": "Traduction de « on »", "categorie": "Traduction de structures", "fiche": "`se + 3e pers.` : le verbe s'accorde avec le nom → `se venden pisos`.\n3e pers. du pluriel : auteur inconnu → `llaman a la puerta`.\n`uno` avec un verbe pronominal → `uno se cansa` ; on = nous → 1re pers. du pluriel.", "voisins": ["es.relatifs"]},
  {"code": "es.relatifs", "langue": "es", "titre": "Traduction de « dont » et relatifs", "categorie": "Traduction de structures", "fiche": "dont + nom possédé → `cuyo/a/os/as`, accordé avec la chose possédée, sans article.\ndont complément de verbe → `del que, de la que, de quien…` selon la préposition du verbe.\nce que → `lo que` ; préposition + article + que : `la casa en la que vivo`.", "voisins": ["es.mise-en-relief"]},
  {"code": "es.depuis", "langue": "es", "titre": "« Depuis » (desde hace, llevar, hace… que)", "categorie": "Traduction de structures", "fiche": "Action toujours en cours → présent, jamais l'imparfait.\n`hace + durée + que + présent` · `présent + desde hace + durée` · `desde + point de départ`.\n`llevar (présent) + durée + gérondif`.", "voisins": ["es.por-para"]},
  {"code": "es.devenir", "langue": "es", "titre": "« Devenir » (hacerse, volverse, ponerse…)", "categorie": "Traduction de structures", "fiche": "**ponerse** + adj. : changement passager. **volverse** + adj. : changement durable, de caractère.\n**hacerse** : volonté, évolution (profession, religion, idées). **llegar a ser** : aboutissement.\n**convertirse en** + nom : transformation. **quedarse** + adj. : état résultant (veuf, sourd).", "voisins": ["es.ser-estar"]},
  {"code": "es.mise-en-relief", "langue": "es", "titre": "Mise en relief « c'est… qui / que »", "categorie": "Traduction de structures", "fiche": "Personne → `es… quien / el que`. Lieu → **donde**. Temps → **cuando**. Manière → **como**. Cause → **por lo que**.\nSer se met au temps du verbe : `fue aquí donde nació`.\nOn répète la préposition : `es con él con quien hablo`.", "voisins": ["es.relatifs"]},
  {"code": "es.irreguliers", "langue": "es", "titre": "Verbes à diphtongue et irréguliers", "categorie": "Temps et modes", "fiche": "Diphtongue sous l'accent : e → ie, o → ue (yo, tú, él, ellos), jamais à nosotros / vosotros.\nVerbes en -ir : e → i ou o → u à l'indefinido, 3e personnes (`pidió`, `durmieron`).\nIndefinidos forts sans accent : `tuve, hice, pude, quise, dije, puse, vine`.", "voisins": ["es.imperatif"]}
],
